{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://greenpump.xyz/api/chat"
    },
    {
      "source": "/api/avatar/:path*",
      "destination": "https://greenpump.xyz/api/avatar/:path*"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/|_vercel/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
