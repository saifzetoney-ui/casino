{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "https://greenpump.xyz/api/chat"
    },
    {
      "source": "/api/avatar/:path*",
      "destination": "https://greenpump.xyz/api/avatar/:path*"
    }
  ]
}
